# Copy to .env for local runs. NEVER commit real values.
GCP_PROJECT=
SECRET_ID=tailscale-authkey
TAILNET=
TAILSCALE_API_TOKEN=
ROTATION_THRESHOLD_DAYS=14
KEY_TTL_SECONDS=7776000
KEY_REUSABLE=true
KEY_EPHEMERAL=false
KEY_PREAUTHORIZED=true
KEY_TAGS=
KEY_DESCRIPTION=managed-rotation
DRY_RUN=true
REVOKE_PREVIOUS=false
NOTIFY_WEBHOOK_URL=
LOCK_TTL_SECONDS=900
