# Example terraform.tfvars for prod environment
# Copy this file to terraform.tfvars and fill in your actual values
# terraform.tfvars is gitignored and will not be committed

# Vault Configuration
vault_token = "hvs.YOUR_VAULT_TOKEN_HERE"

# Optional: Override default vault address if needed
# vault_address = "http://100.105.217.77:8200"

# Required: Set root password for prod containers
root_password = "your-secure-password-here"

# Optional: Override other variables
# container_id = 103
# hostname = "your-hostname"

#========= GCP Configuration =================
# Required: GCP project ID (uses GOOGLE_CREDENTIALS from environment for auth)
gcp_project_id = "your-gcp-project-id"

# Optional: GCP zone and region
# gcp_zone = "us-central1-a"
# gcp_region = "us-central1"

# Optional: VM configuration
# gcp_instance_name = "prod-vm-01"
# gcp_machine_type = "e2-medium"

# Optional: SSH keys (format: username:ssh-rsa AAAAB3...)
# gcp_ssh_keys = "username:ssh-rsa AAAAB3NzaC1yc2EAAAA..."

# Optional: extra raw "user:key" lines appended to instance SSH metadata
# (use for keys added via console so plans stay clean)
# gcp_ssh_extra_keys = [
#   "danielolaibi:ssh-rsa AAAAB3...",
# ]

#========= GCP Secrets =================
# Required: Tailscale authentication key for VPN access
tailscale_authkey = "tskey-auth-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx"

#========= GCP Storage =================
# Required: Globally unique bucket name for infrastructure storage (Terraform state, configs, backups)
gcp_infra_bucket_name = "iv3-infra-us-prod"

